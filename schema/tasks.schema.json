{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-hannah-hoech.example/mathe9/tasks.schema.json",
  "title": "Mathe 9 · Einheit (tasks.json)",
  "type": "object",
  "required": [
    "unit",
    "title",
    "leitidee",
    "standards",
    "wortspeicher",
    "can_do",
    "lernkarten",
    "formelkarte",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "unit": {
      "type": "string",
      "pattern": "^(EF|PZ|LF|KP|SK)-\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "leitidee": {
      "type": "string"
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "wortspeicher": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worterklaerungen": {
      "type": "object",
      "description": "Ein Satz je Begriff, Alltagssprache. Schlüssel ohne Artikel.",
      "additionalProperties": {
        "type": "string",
        "minLength": 5
      }
    },
    "can_do": {
      "type": "object",
      "required": [
        "A",
        "B",
        "C"
      ],
      "additionalProperties": false,
      "properties": {
        "A": {
          "type": "string"
        },
        "B": {
          "type": "string"
        },
        "C": {
          "type": "string"
        }
      }
    },
    "lernkarten": {
      "type": "object",
      "required": [
        "A",
        "B",
        "C"
      ],
      "additionalProperties": false,
      "properties": {
        "A": {
          "$ref": "#/$defs/lernkarte"
        },
        "B": {
          "$ref": "#/$defs/lernkarte"
        },
        "C": {
          "$ref": "#/$defs/lernkarte"
        }
      }
    },
    "formelkarte": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formeln": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "saetze": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "quiz": {
      "type": "object",
      "description": "Eigene Quizfragen je Pfad. Nur nötig, wenn die erzeugten Fragen für diese Einheit nicht passen — sie treten dann an deren Stelle. Alle Fragen müssen sich auf DIESE Einheit beziehen; ein Quiz, das anderswoher zieht, misst nicht die Einheit.",
      "additionalProperties": false,
      "properties": {
        "A": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quizfrage"
          },
          "minItems": 3,
          "maxItems": 5
        },
        "B": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quizfrage"
          },
          "minItems": 3,
          "maxItems": 5
        },
        "C": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quizfrage"
          },
          "minItems": 3,
          "maxItems": 5
        }
      }
    },
    "uebungslinks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uebungslink"
      }
    },
    "videos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/video"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/aufgabe"
      }
    },
    "pruefung": {
      "type": [
        "object",
        "null"
      ]
    },
    "pfad_fest": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "reihenfolge_fest": {
      "type": "boolean"
    },
    "hilfen": {
      "type": "boolean"
    }
  },
  "$defs": {
    "lernkarte": {
      "type": "object",
      "required": [
        "titel",
        "hinfuehrung",
        "erklaerung",
        "merke"
      ],
      "additionalProperties": false,
      "properties": {
        "titel": {
          "type": "string"
        },
        "hinfuehrung": {
          "type": "string"
        },
        "erklaerung": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "merke": {
          "type": "string"
        },
        "bild_oben": {
          "type": "boolean"
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "beispiel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "titel": {
              "type": "string"
            },
            "aufgabe": {
              "type": "string"
            },
            "schritte": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ergebnis": {
              "type": "string"
            },
            "luecke": {
              "type": "object",
              "description": "Welche Zahl im Rechenweg ergänzt werden soll (nur Pfad A).",
              "required": [
                "schritt",
                "wert"
              ],
              "additionalProperties": false,
              "properties": {
                "schritt": {
                  "type": "integer",
                  "minimum": 0
                },
                "wert": {
                  "type": "number"
                },
                "einheit": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "visual": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "streifen",
            "koordinaten",
            "koerper",
            "geogebra",
            "animation"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "animation"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "stufe": {
                "enum": [
                  "A",
                  "B",
                  "C"
                ]
              },
              "thema": {
                "type": "string"
              },
              "form": {
                "type": "string"
              },
              "bereich": {
                "enum": [
                  "ef",
                  "pz",
                  "lf",
                  "kp",
                  "sk"
                ]
              },
              "rechnung": {
                "type": "boolean"
              },
              "breite": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "koerper"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "form",
              "alt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "streifen"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "fill"
            ]
          }
        }
      ]
    },
    "fehlvorstellung": {
      "type": "object",
      "required": [
        "id",
        "value",
        "feedback"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "konzeptfehler": {
          "type": "string",
          "description": "Gruppiert IDs, die denselben Denkfehler meinen. Steuert die Suche nach einer Nachfassaufgabe.",
          "enum": [
            "prozentschritt_unvollstaendig",
            "grundwert_prozentwert_vertauscht",
            "mal_geteilt_vertauscht",
            "drittel_vergessen",
            "vorzeichen",
            "stellenwert_faktor",
            "grundflaeche_unvollstaendig",
            "quadrieren_vergessen",
            "dreiecksflaeche_halbe",
            "radius_durchmesser",
            "achsen_vertauscht",
            "m_und_b_vertauscht",
            "hoehe_statt_seitenhoehe"
          ]
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "feedback": {
          "type": "string",
          "minLength": 5
        },
        "verweis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "absatz": {
              "type": "integer",
              "minimum": 0
            },
            "animation": {
              "type": "boolean"
            },
            "merke": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "aufgabe": {
      "type": "object",
      "required": [
        "id",
        "path",
        "step",
        "type",
        "prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3
        },
        "path": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "type": {
          "enum": [
            "numeric",
            "choice",
            "assign",
            "multi"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 3
        },
        "answer": {
          "type": [
            "number",
            "integer",
            "array"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "answer"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "answer": {
                "type": "number"
              },
              "unit_label": {
                "type": "string"
              },
              "tolerance": {
                "type": "number"
              },
              "misconceptions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/fehlvorstellung"
                }
              }
            }
          }
        },
        "unit_label": {
          "type": "string"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "solution": {
          "type": "string"
        },
        "misconceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fehlvorstellung"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spiral": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "herkunft": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "numeric"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "answer"
            ],
            "properties": {
              "answer": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options",
              "answer"
            ],
            "properties": {
              "answer": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "assign"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "slots",
              "values",
              "answer"
            ],
            "properties": {
              "answer": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "multi"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "fields"
            ]
          }
        }
      ]
    },
    "uebungslink": {
      "type": "object",
      "required": [
        "titel",
        "url",
        "typ",
        "quelle"
      ],
      "additionalProperties": false,
      "properties": {
        "pfade": {
          "type": "array",
          "description": "Optional: Nur auf diesen Lernwegen anzeigen. Ohne Angabe auf allen — das ist der Normalfall. Gedacht für offene Übersichts- und Ordnerseiten, die auf dem Basisweg erst sortiert werden müssten.",
          "items": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "titel": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "typ": {
          "enum": [
            "app",
            "sammlung"
          ]
        },
        "quelle": {
          "enum": [
            "LearningApps",
            "Serlo",
            "H5P",
            "Learningsnacks",
            "Quizlet",
            "ZUM"
          ]
        }
      }
    },
    "video": {
      "type": "object",
      "required": [
        "titel",
        "url",
        "quelle"
      ],
      "additionalProperties": false,
      "properties": {
        "titel": {
          "type": "string",
          "minLength": 3,
          "description": "Beschreibt, was das Video zeigt. Bewusst NICHT der Originaltitel: Der ist auf YouTube teils automatisch übersetzt und passt dann nicht mehr zur Einheit."
        },
        "url": {
          "type": "string",
          "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$",
          "description": "Nur die kanonische Watch-Adresse. Keine Playlists, keine Zeitmarken, keine Kurzlinks — sonst lässt sich nicht prüfen, worauf verwiesen wird."
        },
        "pfad": {
          "enum": [
            "A",
            "B",
            "C"
          ],
          "description": "Optional: Nur auf diesem Lernweg anzeigen. Ohne Angabe auf allen."
        },
        "quelle": {
          "enum": [
            "Lehrerschmidt"
          ]
        }
      }
    },
    "quizfrage": {
      "type": "object",
      "description": "Eine von Hand geschriebene Quizfrage. Optional: Ohne dieses Feld setzt quiz.js das Abschlussquiz aus dem Material der Einheit selbst zusammen — Merksatz, Erklärung, Formelkarte, Wortspeicher und zwei Aufgaben derselben Stufe.",
      "required": [
        "frage",
        "optionen",
        "antwort"
      ],
      "additionalProperties": false,
      "properties": {
        "frage": {
          "type": "string",
          "minLength": 8
        },
        "optionen": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3,
          "maxItems": 5,
          "description": "Mindestens drei. Zwei Möglichkeiten wären in einer gewerteten Frage ein Münzwurf."
        },
        "antwort": {
          "type": "integer",
          "minimum": 0
        },
        "aufloesung": {
          "type": "string",
          "description": "Was nach der Antwort erklärt wird."
        }
      }
    }
  }
}
