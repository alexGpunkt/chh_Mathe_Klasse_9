{
  "bereich": "PZ",
  "title": "Prozent- und Zinsrechnung",
  "_hinweis": "Generatoren für die handschriftlichen Übungsblätter. Format wie in spiral/*.json — ausgewertet von assets/js/ausdruck.js, damit die gedruckten Lösungen von demselben Code stammen wie die Prüfung in der Anwendung. Die Aufgaben sind bewusst NICHT die digitalen: gleiches Thema, andere Zahlen, andere Einkleidung. Die Einträge unter misconceptions liefern die falschen Antworten für den Selbstkontrollkasten — typische Fehler sind dort brauchbarer als Zufallszahlen.",
  "einheiten": {
    "pz-01": {
      "auftrag": "Rechne jede Aufgabe schriftlich. Schreibe bei den Umwandlungen den Rechenweg dazu.",
      "aufgaben": [
        {
          "id": "AB-PZ-01-1",
          "vars": { "z": { "von": 1, "bis": 19 }, "n": { "aus": [4, 5, 8, 10, 20, 25, 50] } },
          "bedingung": "(z < n) * ganz(z * 1000 / n)",
          "template": "Schreibe den Bruch {z}/{n} als Prozentsatz.",
          "answer": "z * 100 / n",
          "unit_label": "%",
          "round": 1,
          "solution": "{z} : {n} = {z/n} und {z/n} · 100 = {ergebnis} %",
          "misconceptions": [
            { "id": "zaehler_als_prozent", "value": "z", "feedback": "Das ist der Zähler, nicht der Anteil." },
            { "id": "nenner_als_prozent", "value": "n", "feedback": "Das ist der Nenner." }
          ]
        },
        {
          "id": "AB-PZ-01-2",
          "vars": { "p": { "von": 5, "bis": 95, "schritt": 5 } },
          "template": "Schreibe {p} % als Dezimalzahl.",
          "answer": "p / 100",
          "round": 2,
          "solution": "{p} : 100 = {ergebnis}",
          "misconceptions": [
            { "id": "komma_verschoben", "value": "p / 10", "feedback": "Ein Komma zu wenig verschoben." },
            { "id": "faktor_100", "value": "p", "feedback": "Prozent heißt „von hundert“ — es muss geteilt werden." }
          ]
        },
        {
          "id": "AB-PZ-01-3",
          "vars": { "h": { "von": 5, "bis": 95, "schritt": 5 } },
          "berechnet": { "d": "h / 100" },
          "template": "Schreibe die Dezimalzahl {d} als Prozentsatz.",
          "answer": "d * 100",
          "unit_label": "%",
          "round": 1,
          "solution": "{d} · 100 = {ergebnis} %",
          "misconceptions": [
            { "id": "faktor_10", "value": "d * 10", "feedback": "Nur eine Stelle verschoben statt zwei." }
          ]
        },
        {
          "id": "AB-PZ-01-4",
          "vars": { "teil": { "von": 3, "bis": 24 }, "ganz": { "aus": [20, 25, 40, 50] } },
          "bedingung": "(teil < ganz) * ganz(teil * 1000 / ganz)",
          "template": "In einer Klasse mit {ganz} Kindern haben {teil} ein Fahrrad dabei. Wie viel Prozent sind das?",
          "answer": "teil * 100 / ganz",
          "unit_label": "%",
          "round": 1,
          "solution": "{teil} : {ganz} = {teil/ganz}, also {ergebnis} %",
          "misconceptions": [
            { "id": "ganzes_statt_teil", "value": "(ganz - teil) * 100 / ganz", "feedback": "Das ist der Anteil OHNE Fahrrad." }
          ]
        },
        {
          "id": "AB-PZ-01-5",
          "vars": { "z": { "aus": [1, 3, 7, 9, 11, 13] }, "n": { "aus": [20, 25, 50] } },
          "bedingung": "(z < n) * ganz(z * 1000 / n)",
          "template": "Ordne der Größe nach: {z}/{n} · 0,5 · 40 %. Gib den größten Wert in Prozent an.",
          "answer": "(z * 100 / n > 50) * (z * 100 / n) + (z * 100 / n <= 50) * 50",
          "unit_label": "%",
          "round": 1,
          "solution": "{z}/{n} = {z*100/n} %, 0,5 = 50 %, 40 % — der größte Wert ist {ergebnis} %."
        }
      ]
    },

    "pz-02": {
      "auftrag": "Schätze zuerst im Kopf und notiere die Schätzung. Rechne danach schriftlich nach.",
      "aufgaben": [
        {
