          "vars": { "G": { "von": 100, "bis": 1000, "schritt": 100 }, "p": { "aus": [10, 20, 25] } },
          "template": "Ein Preis von {G} € steigt um {p} % und fällt danach wieder um {p} %. Wie hoch ist er am Ende?",
          "answer": "G * (100 + p) / 100 * (100 - p) / 100",
          "unit_label": "€",
          "round": 2,
          "solution": "{G} · {(100+p)/100} = {G*(100+p)/100} €, davon {100-p} %: {ergebnis} €",
          "misconceptions": [
