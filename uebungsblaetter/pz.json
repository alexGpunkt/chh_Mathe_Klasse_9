          "answer": "G / 4",
          "unit_label": "€",
          "round": 2,
          "solution": "25 % ist ein Viertel: {G} : 4 = {ergebnis} €",
          "misconceptions": [
            { "id": "haelfte_verwechselt", "value": "G / 2", "feedback": "Das ist die Hälfte, also 50 %." }
          ]
        },
        {
