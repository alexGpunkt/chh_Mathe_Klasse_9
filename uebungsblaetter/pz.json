    "pz-04": {
      "auftrag": "Prüfe bei jeder Aufgabe ZUERST schriftlich: proportional oder antiproportional? Begründe in einem Satz.",
      "aufgaben": [
        {
          "id": "AB-PZ-04-1",
          "vars": { "n": { "von": 2, "bis": 8 }, "tage": { "von": 6, "bis": 30, "schritt": 2 }, "neu": { "von": 2, "bis": 12 } },
          "berechnet": { "arbeit": "n * tage" },
          "bedingung": "ganz(arbeit * 10 / neu) * (neu != n)",
          "template": "{n} Maler brauchen {tage} Tage. Wie lange brauchen {neu} Maler?",
          "answer": "arbeit / neu",
          "unit_label": "Tage",
          "round": 1,
          "solution": "Gesamtarbeit: {n} · {tage} = {arbeit} Tagewerke. {arbeit} : {neu} = {ergebnis} Tage",
          "misconceptions": [
            { "id": "proportional_gerechnet", "value": "tage / n * neu", "feedback": "Mehr Maler heißt WENIGER Tage — antiproportional." }
          ]
        },
        {
          "id": "AB-PZ-04-2",
          "vars": { "v": { "aus": [40, 60, 80, 90, 120] }, "t": { "aus": [2, 3, 4, 6] }, "vneu": { "aus": [30, 40, 60, 80, 120] } },
          "berechnet": { "s": "v * t" },
          "bedingung": "ganz(s * 10 / vneu) * (vneu != v)",
          "template": "Bei {v} km/h dauert die Fahrt {t} Stunden. Wie lange dauert sie bei {vneu} km/h?",
          "answer": "s / vneu",
          "unit_label": "h",
          "round": 1,
          "solution": "Strecke: {v} · {t} = {s} km. {s} : {vneu} = {ergebnis} h",
          "misconceptions": [
            { "id": "proportional_gerechnet", "value": "t / v * vneu", "feedback": "Schneller heißt kürzer — antiproportional." }
          ]
        },
        {
          "id": "AB-PZ-04-3",
          "vars": { "n": { "von": 3, "bis": 10 }, "preis": { "von": 2, "bis": 9 }, "neu": { "von": 12, "bis": 40, "schritt": 2 } },
          "berechnet": { "gesamt": "n * preis" },
          "template": "{n} Eintrittskarten kosten {gesamt} €. Was kosten {neu} Karten? (Proportional oder nicht?)",
          "answer": "neu * preis",
          "unit_label": "€",
          "round": 2,
          "solution": "Proportional. Eine Karte: {preis} €. {neu} Karten: {ergebnis} €",
          "misconceptions": [
            { "id": "antiproportional_gerechnet", "value": "gesamt * n / neu", "feedback": "Mehr Karten kosten mehr — das ist proportional." }
          ]
        },
        {
          "id": "AB-PZ-04-4",
          "vars": { "gaeste": { "aus": [6, 8, 10, 12, 15, 20] }, "tage": { "aus": [4, 6, 8, 10, 12] }, "neu": { "aus": [4, 5, 6, 8, 10, 12] } },
          "berechnet": { "vorrat": "gaeste * tage" },
          "bedingung": "ganz(vorrat * 10 / neu) * (neu != gaeste)",
          "template": "Ein Vorrat reicht für {gaeste} Personen {tage} Tage. Wie lange reicht er für {neu} Personen?",
          "answer": "vorrat / neu",
          "unit_label": "Tage",
          "round": 1,
          "solution": "Vorrat: {gaeste} · {tage} = {vorrat} Personentage. {vorrat} : {neu} = {ergebnis} Tage"
        },
        {
          "id": "AB-PZ-04-5",
          "vars": { "a": { "von": 2, "bis": 9 }, "b": { "von": 12, "bis": 48, "schritt": 2 } },
          "berechnet": { "prod": "a * b" },
          "template": "Bei einer antiproportionalen Zuordnung gehört zu {a} der Wert {b}. Welcher Wert gehört zu {2*a}?",
          "answer": "prod / (2 * a)",
          "round": 2,
          "solution": "Das Produkt bleibt gleich: {a} · {b} = {prod}. {prod} : {2*a} = {ergebnis}",
          "misconceptions": [
            { "id": "proportional_gerechnet", "value": "2 * b", "feedback": "Bei antiproportional wird das Doppelte zur Hälfte, nicht zum Doppelten." }
          ]
        }
      ]
    },

    "pz-05": {
      "auftrag": "Schreibe zu jeder Aufgabe auf, was G, W und p % sind — erst danach rechnen.",
      "aufgaben": [
        {
          "id": "AB-PZ-05-1",
          "vars": { "G": { "von": 40, "bis": 400, "schritt": 20 }, "p": { "aus": [10, 20, 25, 50] } },
          "template": "Von {G} Schülerinnen und Schülern gehen {p} % zu Fuß zur Schule. Wie viele sind das? Benenne zuerst G, W und p %.",
