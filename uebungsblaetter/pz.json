          "vars": { "n": { "von": 4, "bis": 12 }, "menge": { "von": 3, "bis": 15 }, "m": { "von": 20, "bis": 60, "schritt": 4 } },
          "berechnet": { "gesamt": "n * menge" },
          "template": "{n} gleiche Kisten wiegen zusammen {gesamt} kg. Wie schwer sind {m} Kisten?",
          "answer": "m * menge",
          "unit_label": "kg",
