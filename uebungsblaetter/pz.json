    "pz-10": {
      "auftrag": "Gib bei jeder Aufgabe den Wachstumsfaktor an, bevor du rechnest.",
      "aufgaben": [
        {
          "id": "AB-PZ-10-1",
          "vars": { "alt": { "aus": [40, 50, 80, 200, 250, 400] }, "diff": { "von": 2, "bis": 80, "schritt": 2 } },
          "bedingung": "ganz(diff * 1000 / alt)",
          "berechnet": { "neu": "alt + diff" },
          "template": "Ein Wert steigt von {alt} auf {neu}. Um wie viel Prozent ist er gestiegen?",
          "answer": "(neu - alt) * 100 / alt",
          "unit_label": "%",
          "round": 1,
          "solution": "p = ({neu} − {alt}) : {alt} · 100 = {ergebnis} %",
          "misconceptions": [
            { "id": "neuer_als_grundwert", "value": "(neu - alt) * 100 / neu", "feedback": "Bezug ist der alte Wert." }
          ]
        },
        {
          "id": "AB-PZ-10-2",
          "vars": { "alt": { "aus": [40, 50, 80, 200, 250, 400] }, "diff": { "von": 2, "bis": 40, "schritt": 2 } },
          "bedingung": "(diff < alt) * ganz(diff * 1000 / alt)",
          "berechnet": { "neu": "alt - diff" },
          "template": "Ein Wert fällt von {alt} auf {neu}. Um wie viel Prozent ist er gefallen?",
          "answer": "(alt - neu) * 100 / alt",
          "unit_label": "%",
          "round": 1,
          "solution": "p = ({alt} − {neu}) : {alt} · 100 = {ergebnis} %"
        },
        {
          "id": "AB-PZ-10-3",
          "vars": { "G": { "von": 100, "bis": 2000, "schritt": 100 }, "p": { "aus": [3, 5, 8, 12] } },
          "template": "Gib den Wachstumsfaktor für eine Zunahme um {p} % an und berechne damit den neuen Wert von {G} €.",
          "answer": "G * (100 + p) / 100",
          "unit_label": "€",
          "round": 2,
          "solution": "q = {(100+p)/100}. {G} · {(100+p)/100} = {ergebnis} €"
        },
        {
          "id": "AB-PZ-10-4",
          "vars": { "G": { "von": 200, "bis": 2000, "schritt": 100 }, "p": { "aus": [10, 20, 25] }, "q": { "aus": [10, 20, 50] } },
          "template": "{G} € nehmen erst um {p} % zu und dann um {q} % ab. Wie viel Euro sind es am Ende?",
          "answer": "G * (100 + p) / 100 * (100 - q) / 100",
          "unit_label": "€",
          "round": 2,
          "solution": "Faktoren multiplizieren: {G} · {(100+p)/100} · {(100-q)/100} = {ergebnis} €",
          "misconceptions": [
            { "id": "prozentsaetze_addiert", "value": "G * (100 + p - q) / 100", "feedback": "Prozentsätze dürfen nicht addiert werden — die Faktoren werden multipliziert." }
          ]
        },
        {
          "id": "AB-PZ-10-5",
          "vars": { "G": { "von": 100, "bis": 1000, "schritt": 100 }, "p": { "aus": [20, 25, 50] } },
          "bedingung": "ganz(p * 1000 / (100 + p))",
          "template": "Um wie viel Prozent muss ein um {p} % gestiegener Wert wieder fallen, damit er beim Ausgangswert {G} landet? Gib den Prozentsatz an.",
          "answer": "p * 100 / (100 + p)",
          "unit_label": "%",
          "round": 1,
          "solution": "Der neue Grundwert ist {G*(100+p)/100}. Rückgang: {G*p/100} : {G*(100+p)/100} · 100 = {ergebnis} %",
          "misconceptions": [
            { "id": "veraenderungen_heben_sich_auf", "value": "p", "feedback": "Der Rückgang bezieht sich auf den größeren Wert." }
          ]
        }
      ]
    },

