          "berechnet": { "Z": "K * p / 100" },
          "template": "Für {K} € gab es in einem Jahr {Z} € Zinsen. Wie hoch war der Zinssatz?",
          "answer": "Z * 100 / K",
          "unit_label": "%",
          "round": 2,
          "solution": "p = {Z} : {K} · 100 = {ergebnis} %"
