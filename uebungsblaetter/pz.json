          ]
        },
        {
          "id": "AB-PZ-05-5",
          "vars": { "G": { "aus": [50, 80, 120, 200] }, "p": { "aus": [15, 25, 35, 45] } },
          "template": "Schreibe einen eigenen Sachaufgabentext, in dem {G} der Grundwert und {p} % der Prozentsatz ist. Berechne dann den Prozentwert.",
          "answer": "G * p / 100",
          "round": 2,
          "solution": "W = {G} · {p} : 100 = {ergebnis}"
