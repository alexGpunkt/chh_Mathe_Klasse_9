          "unit_label": "Kisten",
          "round": 0,
          "solution": "Pro Stunde: {leistung} : {stunden} = {arbeiter} Kisten. In {neu} Stunden: {ergebnis}"
        },
        {
          "id": "AB-PZ-03-5",
          "vars": { "preis": { "von": 2, "bis": 9 }, "n": { "von": 6, "bis": 20, "schritt": 2 }, "budget": { "von": 30, "bis": 120, "schritt": 6 } },
          "bedingung": "ganz(budget / preis)",
          "template": "Eine Packung kostet {preis} €. Wie viele Packungen bekommt man für {budget} €?",
          "answer": "budget / preis",
          "unit_label": "Packungen",
          "round": 0,
          "solution": "{budget} : {preis} = {ergebnis} Packungen"
        }
      ]
