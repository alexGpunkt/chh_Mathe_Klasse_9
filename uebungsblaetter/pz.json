          "vars": { "G": { "von": 60, "bis": 900, "schritt": 20 } },
          "template": "Schätze: 21 % von {G} € sind ungefähr wie viel? Rechne mit 20 %.",
          "answer": "G / 5",
          "unit_label": "€",
          "round": 2,
          "solution": "20 % = ein Fünftel: {G} : 5 = {ergebnis} €",
          "misconceptions": [
            { "id": "haelfte_verwechselt", "value": "G / 4", "feedback": "Das wäre ein Viertel, also 25 %." }
          ]
        },
        {
          "id": "AB-PZ-02-4",
          "vars": { "G": { "von": 200, "bis": 2000, "schritt": 100 } },
          "template": "Wie viel sind 5 % von {G} €? (Tipp: 10 % halbieren)",
          "answer": "G / 20",
          "unit_label": "€",
          "round": 2,
          "solution": "10 % sind {G/10} €, die Hälfte davon ist {ergebnis} €",
          "misconceptions": [
            { "id": "bei_1prozent_gestoppt", "value": "G / 10", "feedback": "Das sind 10 %, nicht 5 %." }
          ]
        },
        {
          "id": "AB-PZ-02-5",
          "vars": { "G": { "von": 60, "bis": 900, "schritt": 20 } },
          "template": "Ein Pullover kostet {G} €. Er wird um 30 % billiger. Schätze den neuen Preis.",
          "answer": "G * 7 / 10",
          "unit_label": "€",
          "round": 2,
          "solution": "30 % von {G} € sind {G*3/10} €. Neuer Preis: {G} − {G*3/10} = {ergebnis} €",
          "misconceptions": [
            { "id": "rabatt_als_rest", "value": "G * 3 / 10", "feedback": "Das ist der Rabatt, nicht der neue Preis." }
          ]
        }
      ]
    },

    "pz-03": {
