        },
        {
          "id": "AB-PZ-03-3",
          "vars": { "km": { "von": 30, "bis": 90, "schritt": 30 }, "liter": { "von": 3, "bis": 9 }, "ziel": { "von": 120, "bis": 600, "schritt": 30 } },
          "template": "Ein Auto braucht für {km} km genau {liter} Liter. Wie viel Liter für {ziel} km?",
          "answer": "ziel / km * liter",
          "unit_label": "l",
          "round": 2,
          "bedingung": "ganz(ziel / km * liter * 100)",
          "solution": "Für 1 km: {liter} : {km} = {liter/km} l. Für {ziel} km: {ergebnis} l"
        },
        {
          "id": "AB-PZ-03-4",
          "vars": { "arbeiter": { "von": 2, "bis": 6 }, "stunden": { "von": 2, "bis": 8 }, "neu": { "von": 8, "bis": 24, "schritt": 2 } },
          "berechnet": { "leistung": "arbeiter * stunden" },
          "template": "{arbeiter} Personen schaffen in {stunden} Stunden {leistung} Kisten. Wie viele Kisten schaffen sie in {neu} Stunden?",
