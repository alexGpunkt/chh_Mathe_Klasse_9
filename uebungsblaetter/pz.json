          "template": "Nach einer Erhöhung um {p} % beträgt die Miete {endwert} €. Wie hoch war sie vorher?",
          "answer": "endwert * 100 / (100 + p)",
          "unit_label": "€",
          "round": 2,
          "solution": "{endwert} : {(100+p)/100} = {ergebnis} €",
          "misconceptions": [
