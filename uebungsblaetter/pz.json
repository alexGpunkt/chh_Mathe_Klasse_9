          "vars": { "p": { "aus": [2, 4, 5] }, "K": { "von": 1000, "bis": 20000, "schritt": 1000 } },
          "berechnet": { "Z": "K * p / 100" },
          "template": "Bei {p} % Zinsen gab es in einem Jahr {Z} € Zinsen. Wie hoch war das Kapital?",
