          "round": 2,
          "solution": "Zinseszins: {K*(100+p)/100*(100+p)/100-K} €, einfacher Zins: {K*p/100*2} €. Unterschied: {ergebnis} €"
        },
        {
          "id": "AB-PZ-13-5",
          "vars": { "K": { "von": 1000, "bis": 9000, "schritt": 1000 }, "p": { "aus": [10, 20, 25] } },
          "template": "Ein Wert von {K} € nimmt zwei Jahre lang um je {p} % AB. Wie viel ist er danach wert?",
          "answer": "K * (100 - p) / 100 * (100 - p) / 100",
          "unit_label": "€",
          "round": 2,
          "solution": "q = {(100-p)/100}. {K} · q · q = {ergebnis} €",
