    "lf-09": {
      "auftrag": "Berechne zuerst m, dann b. Schreibe am Ende die vollständige Gleichung auf.",
      "aufgaben": [
        {
          "id": "AB-LF-09-1",
          "vars": { "x1": { "von": 0, "bis": 4 }, "dx": { "von": 1, "bis": 5 }, "m": { "aus": [-3, -2, -1, 1, 2, 3] }, "b": { "aus": [-4, -1, 2, 5] } },
          "berechnet": { "y1": "m * x1 + b", "x2": "x1 + dx", "y2": "m * (x1 + dx) + b" },
          "template": "Bestimme die Gleichung der Geraden durch A({x1}|{y1}) und B({x2}|{y2}). Gib m an.",
          "answer": "m",
          "round": 2,
          "solution": "m = ({y2} − {y1}) : ({x2} − {x1}) = {ergebnis}, dann b = {y1} − {m} · {x1} = {b}"
        },
        {
          "id": "AB-LF-09-2",
          "vars": { "x1": { "von": 1, "bis": 5 }, "dx": { "von": 1, "bis": 4 }, "m": { "aus": [-2, -1, 1, 2, 4] }, "b": { "aus": [-5, -2, 3, 6] } },
          "berechnet": { "y1": "m * x1 + b", "x2": "x1 + dx", "y2": "m * (x1 + dx) + b" },
          "template": "Bestimme b für die Gerade durch A({x1}|{y1}) und B({x2}|{y2}).",
          "answer": "b",
          "round": 2,
          "solution": "m = {m}, dann b = {y1} − {m} · {x1} = {ergebnis}"
        },
        {
          "id": "AB-LF-09-3",
          "vars": { "x1": { "von": 0, "bis": 3 }, "dx": { "von": 2, "bis": 6, "schritt": 2 }, "m": { "aus": [0.5, 1.5, 2.5] }, "b": { "aus": [-2, 1, 4] } },
          "berechnet": { "y1": "m * x1 + b", "x2": "x1 + dx", "y2": "m * (x1 + dx) + b" },
          "template": "Die Gerade durch ({x1}|{y1}) und ({x2}|{y2}) hat eine gebrochene Steigung. Berechne m.",
          "answer": "m",
          "round": 2,
          "solution": "m = ({y2} − {y1}) : {dx} = {ergebnis}"
        },
        {
          "id": "AB-LF-09-4",
          "vars": { "m": { "aus": [-2, -1, 2, 3] }, "b": { "aus": [-3, 2, 5] }, "x1": { "von": 1, "bis": 4 }, "dx": { "von": 1, "bis": 4 } },
          "berechnet": { "y1": "m * x1 + b", "x2": "x1 + dx", "y2": "m * (x1 + dx) + b", "x3": "x1 + dx + 2" },
          "template": "Die Gerade geht durch ({x1}|{y1}) und ({x2}|{y2}). Welchen y-Wert hat sie bei x = {x3}?",
          "answer": "m * x3 + b",
          "round": 2,
          "solution": "m = {m}, b = {b}. Bei x = {x3}: {ergebnis}"
        },
        {
          "id": "AB-LF-09-5",
          "vars": { "m": { "aus": [2, 3, 4] }, "b": { "aus": [-6, -4, -2] }, "x1": { "von": 1, "bis": 3 }, "dx": { "von": 2, "bis": 5 } },
          "berechnet": { "y1": "m * x1 + b", "x2": "x1 + dx", "y2": "m * (x1 + dx) + b" },
          "bedingung": "ganz((0 - b) * 100 / m)",
          "template": "Bestimme aus A({x1}|{y1}) und B({x2}|{y2}) die Gleichung und daraus die Nullstelle.",
          "answer": "(0 - b) / m",
          "round": 2,
          "solution": "y = {m}x {b:±}. Nullstelle: 0 = {m}x {b:±} → x = {ergebnis}"
        }
      ]
    },

