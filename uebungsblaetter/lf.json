          "bedingung": "ganz((waag - b) * 100 / m)",
          "template": "Zeichne y = {m}x {b:±} und die waagerechte Gerade y = {waag}. Wo liegt der Schnittpunkt? Gib x an.",
          "answer": "(waag - b) / m",
          "round": 2,
          "solution": "{waag} = {m}x {b:±} → x = {ergebnis}"
