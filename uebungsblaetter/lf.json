    "lf-11": {
      "auftrag": "Notiere hinter jedem Umformungsschritt, was du auf beiden Seiten gemacht hast (| −5, | : 3 …).",
      "aufgaben": [
        {
          "id": "AB-LF-11-1",
          "vars": { "a": { "von": 2, "bis": 9 }, "x": { "von": 2, "bis": 12 }, "b": { "aus": [-12, -8, -5, 3, 7, 11] } },
          "berechnet": { "c": "a * x + b" },
          "template": "Löse: {a}x {b:±} = {c}",
          "answer": "x",
          "round": 2,
          "solution": "{a}x = {c} − ({b}) = {a*x} | : {a} → x = {ergebnis}"
        },
        {
          "id": "AB-LF-11-2",
          "vars": { "a": { "von": 2, "bis": 8 }, "d": { "von": 1, "bis": 6 }, "x": { "von": 1, "bis": 10 }, "b": { "aus": [-9, -4, 2, 6] } },
          "bedingung": "a != d",
          "berechnet": { "links": "a * x + b", "rechtsB": "(a - d) * x + b" },
          "template": "Löse: {a}x {b:±} = {d}x + {rechtsB}",
          "answer": "x",
          "round": 2,
          "solution": "{a}x − {d}x = {rechtsB} − ({b}) → {a-d}x = {(a-d)*x} → x = {ergebnis}"
        },
        {
          "id": "AB-LF-11-3",
          "vars": { "a": { "von": 2, "bis": 6 }, "k": { "von": 1, "bis": 8 }, "x": { "von": 1, "bis": 9 } },
          "berechnet": { "c": "a * (x + k)" },
          "template": "Löse: {a}·(x + {k}) = {c}",
          "answer": "x",
          "round": 2,
          "solution": "{a}x + {a*k} = {c} → {a}x = {a*x} → x = {ergebnis}",
          "misconceptions": [
            { "id": "klammer_nur_halb", "value": "(c - k) / a", "feedback": "Die Klammer muss vollständig ausmultipliziert werden." }
          ]
        },
        {
          "id": "AB-LF-11-4",
          "vars": { "n": { "aus": [2, 3, 4, 5] }, "x": { "von": 2, "bis": 20, "schritt": 2 }, "b": { "aus": [-6, -3, 4, 8] } },
          "bedingung": "ganz(x / n)",
          "berechnet": { "c": "x / n + b" },
          "template": "Löse: x : {n} {b:±} = {c}",
          "answer": "x",
          "round": 2,
          "solution": "x : {n} = {c} − ({b}) = {x/n} | · {n} → x = {ergebnis}"
        },
        {
          "id": "AB-LF-11-5",
          "vars": { "a": { "von": 2, "bis": 7 }, "k": { "von": 1, "bis": 6 }, "d": { "von": 1, "bis": 5 }, "x": { "von": 1, "bis": 8 } },
          "bedingung": "a != d",
          "berechnet": { "rechts": "d * x + a * (x + k) - d * x" },
          "template": "Löse: {a}·(x + {k}) − {d}x = {rechts} − {d}x",
          "answer": "x",
          "round": 2,
          "solution": "Beide Seiten + {d}x, dann {a}x + {a*k} = {rechts} → x = {ergebnis}"
        }
      ]
    },

