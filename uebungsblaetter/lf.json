          "bedingung": "(budget > grund) * ganz((budget - grund) * 100 / pro)",
          "template": "Tarif A: {grund} € Grundgebühr + {pro} €/min. Wie viele Minuten kann man für {budget} € telefonieren?",
          "answer": "(budget - grund) / pro",
