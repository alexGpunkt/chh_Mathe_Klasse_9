  "lernkarten": {
    "A": {
      "titel": "Die richtige Formel wählen",
      "hinfuehrung": "Erkenne zuerst den Körper.",
      "erklaerung": [
        "Eckig unten mit Spitze: Pyramide. Rund unten mit Spitze: Kegel.",
        "Überall rund: Kugel. Dann nimmst du die Formel von der Formelkarte."
      ],
      "beispiel": {
        "aufgabe": "Ein Körper hat einen Grundkreis und eine Spitze. Welche Volumenformel?",
        "schritte": [
          "Grundkreis + Spitze → Kegel",
          "Volumen des Kegels"
        ],
        "ergebnis": "V = (π · r² · h) : 3."
      },
      "merke": "Erst den Körper erkennen. Dann die Formel.",
      "visual": {
        "type": "animation",
        "name": "signalwoerter",
        "stufe": "A",
        "bereich": "sk"
      }
    },
    "B": {
      "titel": "Gemischte Prüfungsaufgaben",
      "hinfuehrung": "Jetzt stehen die Spitzkörper bunt gemischt und ohne Ansage, was gefragt ist. Du erkennst Typ und Größe selbst.",
      "erklaerung": [
        "Bestimme Körper und gesuchte Größe (Volumen/Oberfläche), sammle die gegebenen Werte.",
        "Fehlt s oder h, hole es mit Pythagoras, bevor du die Hauptformel anwendest."
      ],
      "beispiel": {
        "aufgabe": "Kugel mit r = 6 cm. Oberfläche (π ≈ 3,14)?",
        "schritte": [
          "Körper: Kugel, gesucht: Oberfläche",
          "O = 4 · π · r² = 4 · 3,14 · 36",
          "O = 452,16 cm²"
        ],
        "ergebnis": "O ≈ 452,16 cm²."
      },
      "merke": "Körper und Größe erkennen, fehlende Stücke per Pythagoras.",
      "visual": {
        "type": "animation",
        "name": "signalwoerter",
        "stufe": "B",
        "bereich": "sk"
      }
    },
    "C": {
      "titel": "Begründen und Plausibilität prüfen",
      "hinfuehrung": "Auf MSA-Niveau begründest du deinen Weg schriftlich und prüfst, ob dein Ergebnis sinnvoll ist.",
      "erklaerung": [
        "Schreibe zu jedem Schritt die verwendete Formel und die Begründung; führe Einheiten mit.",
        "Plausibilität: Vergleiche z. B. mit einem bekannten Körper (ein Kegel fasst ein Drittel des Zylinders) oder prüfe die Größenordnung."
      ],
      "beispiel": {
        "aufgabe": "Passt in einen Kegel (r = 5 cm, h = 12 cm) mehr als ein halber Liter? (π ≈ 3,14)",
        "schritte": [
          "V = (3,14 · 25 · 12) : 3 = 942 : 3 = 314 cm³",
          "314 cm³ = 0,314 dm³ = 0,314 l",
          "0,314 l < 0,5 l"
        ],
        "ergebnis": "Nein, nur ≈ 0,31 l – weniger als ein halber Liter."
      },
      "merke": "Formel + Begründung + Einheiten, dann Größenordnung prüfen.",
      "visual": {
        "type": "animation",
        "name": "signalwoerter",
        "stufe": "C",
        "bereich": "sk"
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "Pyramide: V = (G·h):3    O = a² + 2·a·s",
      "Kegel: V = (π·r²·h):3    O = π·r² + π·r·s",
      "Kugel: V = (4·π·r³):3    O = 4·π·r²",
      "Pythagoras: Pyramide s=√(h²+(a:2)²) · Kegel s=√(r²+h²)"
    ],
    "saetze": [
      "Erst: welcher Körper? Dann: Volumen oder Oberfläche?",
      "Spitzkörper haben immer den Faktor ⅓ im Volumen."
    ]
  },
