{
  "unit": "SK-04",
  "title": "Oberfläche der Pyramide",
  "leitidee": "L2",
  "standards": [
    "K5",
    "K2"
  ],
  "wortspeicher": [
    "die Oberfläche",
    "die Grundfläche",
    "der Mantel",
    "das Seitendreieck",
    "die Seitenhöhe",
    "der Satz des Pythagoras"
  ],
  "can_do": {
    "A": "Du berechnest die Fläche eines Seitendreiecks über (a · s) : 2.",
    "B": "Du berechnest die Oberfläche = Grundfläche + Mantel (4 Dreiecke).",
    "C": "Du bestimmst zuerst die Seitenhöhe mit Pythagoras und dann die Oberfläche."
  },
  "lernkarten": {
    "A": {
      "titel": "Fläche eines Seitendreiecks",
      "hinfuehrung": "Jede Seitenfläche der Pyramide ist ein Dreieck.",
      "erklaerung": [
        "Die Grundseite des Dreiecks ist die Grundkante a.",
        "Die Höhe im Dreieck ist die Seitenhöhe s. Rechne (a · s) : 2."
      ],
      "visual": {
        "type": "animation",
        "name": "obpyr",
        "stufe": "A"
      },
      "beispiel": {
        "aufgabe": "Ein Seitendreieck hat a = 6 cm und s = 5 cm. Wie groß ist die Fläche?",
        "schritte": [
          "Fläche = (a · s) : 2",
          "= (6 · 5) : 2 = 30 : 2",
          "= 15 cm²"
        ],
        "ergebnis": "Ein Seitendreieck hat 15 cm²."
      },
      "merke": "Seitendreieck = (a · s) : 2."
    },
    "B": {
      "titel": "Oberfläche = Grundfläche + Mantel",
      "hinfuehrung": "Die Oberfläche der quadratischen Pyramide sind das Grundquadrat und die vier gleichen Seitendreiecke.",
      "erklaerung": [
        "Mantel = 4 · (a · s) : 2 = 2 · a · s.",
        "Oberfläche O = a² + 2 · a · s (Grundfläche plus Mantel)."
      ],
      "beispiel": {
        "aufgabe": "Quadratische Pyramide: a = 6 cm, s = 5 cm. Oberfläche?",
        "schritte": [
          "Grundfläche = a² = 36 cm²",
          "Mantel = 2 · a · s = 2 · 6 · 5 = 60 cm²",
          "O = 36 + 60 = 96 cm²"
        ],
        "ergebnis": "O = 96 cm²."
      },
      "merke": "Quadratische Pyramide: O = a² + 2 · a · s.",
      "visual": {
        "type": "animation",
        "name": "obpyr",
        "stufe": "B"
      }
    },
    "C": {
      "titel": "Erst die Seitenhöhe, dann die Oberfläche",
      "hinfuehrung": "Oft ist s nicht gegeben, sondern nur h und a. Dann berechnest du zuerst s mit Pythagoras und danach die Oberfläche.",
      "erklaerung": [
        "Seitenhöhe: s = √( h² + (a : 2)² ).",
        "Dann O = a² + 2 · a · s. Zwei Schritte, sauber getrennt."
      ],
      "beispiel": {
        "aufgabe": "Pyramide mit a = 6 cm, h = 4 cm. Berechne die Oberfläche.",
        "schritte": [
          "s = √(4² + 3²) = √(16 + 9) = √25 = 5 cm",
          "Mantel = 2 · 6 · 5 = 60 cm²",
          "O = 6² + 60 = 36 + 60 = 96 cm²"
        ],
        "ergebnis": "O = 96 cm²."
      },
      "merke": "Erst s = √( h² + (a:2)² ), dann O = a² + 2·a·s.",
      "visual": {
        "type": "animation",
        "name": "obpyr",
        "stufe": "C"
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "O = Grundfläche + Mantel",
      "quadratische Pyramide: Mantel = 4 · (a · s) : 2 = 2 · a · s",
      "Grundfläche = a²      →   O = a² + 2 · a · s",
      "s zuerst mit Pythagoras: s = √( h² + (a:2)² )"
    ],
    "saetze": [
      "Für die Oberfläche brauchst du die Seitenhöhe s, nicht h.",
      "Ein Seitendreieck: Grundlinie a, Höhe s → (a·s):2."
    ]
  },
