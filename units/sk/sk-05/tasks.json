  ],
  "can_do": {
    "A": "Du entscheidest, ob Volumen oder Oberfläche gefragt ist, und wählst die richtige Formel.",
    "B": "Du bestimmst fehlende Größen (h, a) aus Volumen oder Oberfläche.",
    "C": "Du löst mehrschrittige, gemischte Pyramidenaufgaben."
  },
  "lernkarten": {
    "A": {
      "titel": "Volumen oder Oberfläche der Pyramide?",
      "hinfuehrung": "Lies zuerst, was gesucht ist.",
      "erklaerung": [
        "„passt hinein“ oder „Liter“ → Volumen: V = (a² · h) : 3.",
        "„Material“ oder „anstreichen“ → Oberfläche: O = a² + 2 · a · s."
      ],
      "beispiel": {
        "aufgabe": "„Wie viel Sand passt in die Pyramide?“ Welche Formel?",
        "schritte": [
          "Signal „passt hinein“ → Rauminhalt",
          "→ Volumen"
        ],
        "ergebnis": "Volumen: V = (a² · h) : 3."
      },
      "merke": "Erst entscheiden. Dann die Formel wählen.",
      "visual": {
        "type": "animation",
        "name": "rueckwaerts",
        "stufe": "A",
        "form": "pyramide"
      }
    },
    "B": {
      "titel": "Fehlende Größen aus Volumen oder Oberfläche",
      "hinfuehrung": "Ist das Volumen gegeben und eine Kante gesucht, stellst du die Formel um.",
      "erklaerung": [
        "Aus V = (a² · h) : 3 folgt h = 3 · V : a² oder a = √(3 · V : h).",
        "Setze die bekannten Werte ein und ziehe – falls nötig – die Wurzel."
      ],
      "beispiel": {
        "aufgabe": "Pyramide mit V = 100 cm³, a = 5 cm. Berechne die Höhe h.",
        "schritte": [
          "h = 3 · V : a²",
          "h = 3 · 100 : 25 = 300 : 25",
          "h = 12 cm"
        ],
        "ergebnis": "h = 12 cm."
      },
      "merke": "h = 3·V : a²,   a = √(3·V : h).",
      "visual": {
        "type": "animation",
        "name": "rueckwaerts",
        "stufe": "B",
        "form": "pyramide"
      }
    },
    "C": {
      "titel": "Mehrschrittige gemischte Aufgaben",
      "hinfuehrung": "Anspruchsvolle Aufgaben verketten mehrere Schritte: erst Pythagoras, dann Fläche, dann Volumen oder Oberfläche.",
      "erklaerung": [
        "Plane die Reihenfolge: Welche Größe brauche ich zuerst? Häufig s aus h und a, dann O.",
        "Halte Zwischenergebnisse mit Einheit fest und schreibe zu jedem Schritt eine kurze Begründung."
      ],
      "beispiel": {
        "aufgabe": "Pyramide: a = 10 cm, h = 12 cm. Berechne die Oberfläche.",
        "schritte": [
          "s = √(12² + 5²) = √(144 + 25) = √169 = 13 cm",
          "Mantel = 2 · 10 · 13 = 260 cm²",
          "O = 10² + 260 = 100 + 260 = 360 cm²"
        ],
        "ergebnis": "O = 360 cm²."
      },
      "merke": "Reihenfolge planen: s zuerst, dann Fläche/Oberfläche.",
      "visual": {
        "type": "animation",
        "name": "rueckwaerts",
        "stufe": "C",
        "form": "pyramide"
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "V = (a² · h) : 3      →   h = 3·V : a²      a = √(3·V : h)",
      "O = a² + 2·a·s",
      "s = √( h² + (a:2)² )",
      "Volumen braucht h · Oberfläche braucht s"
    ],
    "saetze": [
      "Erst fragen: Volumen (cm³) oder Oberfläche (cm²)?",
      "Volumen → Höhe h. Oberfläche → Seitenhöhe s."
    ]
  },
