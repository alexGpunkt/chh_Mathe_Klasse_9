{
  "unit": "SK-10",
  "title": "Die Kugel: Volumen und Oberfläche",
  "leitidee": "L2",
  "standards": [
    "K5",
    "K3"
  ],
  "wortspeicher": [
    "die Kugel",
    "der Radius",
    "der Durchmesser",
    "das Volumen",
    "die Oberfläche",
    "die Kreiszahl π"
  ],
  "can_do": {
    "A": "Du berechnest die Kugeloberfläche über 4 · π · r².",
    "B": "Du berechnest das Kugelvolumen über 4/3 · π · r³.",
    "C": "Du berechnest Volumen und Oberfläche der Kugel in Sachaufgaben."
  },
  "lernkarten": {
    "A": {
      "titel": "Oberfläche der Kugel",
      "hinfuehrung": "Die Kugel ist der rundeste Körper. Ihre Oberfläche hängt nur vom Radius ab.",
      "erklaerung": [
        "Oberfläche: O = 4 · π · r².",
        "Nur der Radius wird gebraucht – kein h, kein s."
      ],
      "visual": {
        "type": "koerper",
        "form": "kugel",
        "labels": {
          "r": "r"
        },
        "alt": "Kugel mit Radius r."
      },
      "beispiel": {
        "aufgabe": "Kugel mit r = 5 cm. Oberfläche (π ≈ 3,14)?",
        "schritte": [
          "O = 4 · π · r²",
          "= 4 · 3,14 · 25",
          "= 314 cm²"
        ],
        "ergebnis": "O = 314 cm²."
      },
      "merke": "Kugel: O = 4 · π · r²."
    },
    "B": {
      "titel": "Volumen der Kugel",
      "hinfuehrung": "Beim Volumen kommt der Radius sogar dreimal vor: r hoch drei. Davor steht der Faktor 4/3.",
      "erklaerung": [
        "Volumen: V = 4/3 · π · r³ = (4 · π · r³) : 3.",
        "Erst r³ (r · r · r), dann mit π multiplizieren, dann · 4 : 3."
      ],
      "visual": {
        "type": "koerper",
        "form": "kugel",
        "labels": {
          "r": "r"
        },
        "alt": "Kugel mit Radius r."
      },
      "beispiel": {
        "aufgabe": "Kugel mit r = 3 cm. Volumen (π ≈ 3,14)?",
        "schritte": [
          "r³ = 3 · 3 · 3 = 27",
          "4 · π · r³ = 4 · 3,14 · 27 = 339,12",
          "V = 339,12 : 3 = 113,04 cm³"
        ],
        "ergebnis": "V ≈ 113,04 cm³."
      },
      "merke": "Kugel: V = (4 · π · r³) : 3."
    },
    "C": {
      "titel": "Kugel in Sachaufgaben",
      "hinfuehrung": "Ob Ball, Murmel oder Tank: Ist nur der Durchmesser gegeben, halbiere zuerst; für Liter rechne in dm.",
      "erklaerung": [
        "r = d : 2 zuerst bestimmen.",
        "Für Liter in dm rechnen (dm³ = l) und am Ende sinnvoll runden."
      ],
      "beispiel": {
        "aufgabe": "Kugeltank mit d = 4 dm. Volumen in Litern (π ≈ 3,14)?",
        "schritte": [
          "r = 4 : 2 = 2 dm",
          "r³ = 8;  4 · 3,14 · 8 = 100,48",
          "V = 100,48 : 3 ≈ 33,5 dm³ = 33,5 l"
        ],
        "ergebnis": "V ≈ 33,5 l."
      },
      "merke": "Erst r = d : 2; in dm gerechnet ergibt dm³ = Liter."
    }
  },
  "formelkarte": {
    "formeln": [
      "Kugel-Oberfläche:  O = 4 · π · r²",
      "Kugel-Volumen:  V = 4/3 · π · r³ = (4 · π · r³) : 3",
      "Durchmesser d = 2·r   →   r = d : 2",
      "r³ = r · r · r"
    ],
    "saetze": [
      "Oberfläche: r², Volumen: r³ (dreimal r).",
      "Bei Halbkugel: alles halbieren (Volumen) — Oberfläche extra überlegen."
    ]
  },
