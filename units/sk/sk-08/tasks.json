  },
  "lernkarten": {
    "A": {
      "titel": "Die Mantelfläche des Kegels",
      "hinfuehrung": "Für den Mantel brauchst du r und s.",
      "erklaerung": [
        "Rechne M = π · r · s.",
        "Nimm die Mantellinie s. Die Höhe h ist hier falsch."
      ],
      "visual": {
        "type": "animation",
        "name": "obkegel",
        "stufe": "A"
      },
      "beispiel": {
        "aufgabe": "Ein Kegel hat r = 3 cm und s = 5 cm. Mantelfläche mit π ≈ 3,14?",
        "schritte": [
          "M = π · r · s",
          "= 3,14 · 3 · 5",
          "= 47,1 cm²"
        ],
        "luecke": {
          "schritt": 2,
          "wert": 47.1,
          "einheit": "cm²"
        },
        "ergebnis": "M ≈ 47,1 cm²."
      },
      "merke": "Kegelmantel: M = π · r · s."
    },
    "B": {
      "titel": "Oberfläche = Grundkreis + Mantel",
      "hinfuehrung": "Die ganze Oberfläche des Kegels sind der Grundkreis und der Mantel zusammen.",
      "erklaerung": [
        "O = π · r² + π · r · s. Ausklammern ergibt O = π · r · (r + s).",
        "Erst Grundkreis, dann Mantel, dann addieren."
      ],
      "beispiel": {
        "aufgabe": "Kegel mit r = 3 cm, s = 5 cm. Oberfläche (π ≈ 3,14)?",
        "schritte": [
          "Grundkreis = 3,14 · 3² = 28,26 cm²",
          "Mantel = 3,14 · 3 · 5 = 47,1 cm²",
          "O = 28,26 + 47,1 = 75,36 cm²"
        ],
        "ergebnis": "O ≈ 75,36 cm²."
      },
      "merke": "Kegel: O = π · r² + π · r · s = π · r · (r + s).",
      "visual": {
        "type": "animation",
        "name": "obkegel",
        "stufe": "B"
      }
    },
    "C": {
      "titel": "Erst die Mantellinie mit Pythagoras",
      "hinfuehrung": "Ist nur r und h gegeben, berechnest du zuerst die Mantellinie s und danach die Oberfläche.",
      "erklaerung": [
        "s = √( r² + h² ).",
        "Dann O = π · r · (r + s). Wieder zwei saubere Schritte."
      ],
      "beispiel": {
        "aufgabe": "Kegel mit r = 6 cm, h = 8 cm. Oberfläche (π ≈ 3,14)?",
        "schritte": [
          "s = √(6² + 8²) = √(36 + 64) = √100 = 10 cm",
          "O = π · r · (r + s) = 3,14 · 6 · (6 + 10)",
          "O = 3,14 · 6 · 16 = 301,44 cm²"
        ],
        "ergebnis": "O ≈ 301,44 cm²."
      },
      "merke": "Erst s = √( r² + h² ), dann O = π · r · (r + s).",
      "visual": {
        "type": "animation",
        "name": "obkegel",
        "stufe": "C"
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "Grundkreis:  A = π · r²",
      "Mantel:  M = π · r · s     (s = Mantellinie)",
      "O = π · r² + π · r · s = π · r · (r + s)",
      "s zuerst: s = √( r² + h² )"
    ],
    "saetze": [
      "Der Mantel braucht die Mantellinie s, nicht die Höhe h.",
      "O = ein Grundkreis + ein Mantel."
    ]
  },
