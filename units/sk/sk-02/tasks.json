    "C": "Du berechnest die fehlende Größe (h oder a) aus zwei gegebenen."
  },
  "lernkarten": {
    "A": {
      "titel": "Das rechtwinklige Dreieck in der Pyramide",
      "hinfuehrung": "In der Pyramide steckt ein rechtwinkliges Dreieck.",
      "erklaerung": [
        "Die Höhe h steht senkrecht in der Mitte. Daneben liegt die halbe Grundkante a : 2.",
        "Die Seitenhöhe s ist die schräge Seite."
      ],
      "visual": {
        "type": "animation",
        "name": "pythpyr",
        "stufe": "A"
      },
      "beispiel": {
        "aufgabe": "Welche drei Größen bilden das rechtwinklige Dreieck?",
        "schritte": [
          "eine Kathete: Höhe h",
          "andere Kathete: halbe Grundkante a : 2",
          "Hypotenuse: Seitenhöhe s"
        ],
        "ergebnis": "h, a : 2 und s – mit dem rechten Winkel zwischen h und a : 2."
      },
      "merke": "Katheten: h und a : 2. Hypotenuse: s."
    },
    "B": {
      "titel": "Seitenhöhe s mit Pythagoras",
      "hinfuehrung": "Kennst du Höhe und Grundkante, berechnest du die Seitenhöhe s mit dem Satz des Pythagoras.",
      "erklaerung": [
        "Im rechtwinkligen Dreieck gilt s² = h² + (a : 2)².",
        "Also s = √( h² + (a : 2)² ). Zuerst quadrieren und addieren, dann die Wurzel ziehen."
      ],
      "beispiel": {
        "aufgabe": "Pyramide mit h = 4 cm, a = 6 cm. Berechne die Seitenhöhe s.",
        "schritte": [
          "a : 2 = 3",
          "s² = h² + (a:2)² = 4² + 3² = 16 + 9 = 25",
          "s = √25 = 5 cm"
        ],
        "ergebnis": "s = 5 cm."
      },
      "merke": "s = √( h² + (a:2)² ).",
      "visual": {
        "type": "animation",
        "name": "pythpyr",
        "stufe": "B"
      }
    },
    "C": {
      "titel": "Fehlende Größe (h oder a) berechnen",
      "hinfuehrung": "Der Pythagoras lässt sich umstellen: Aus s und a bekommst du h, aus s und h die halbe Grundkante.",
      "erklaerung": [
        "Nach h umgestellt: h = √( s² − (a : 2)² ).",
        "Nach der halben Grundkante: (a : 2) = √( s² − h² ), dann mal 2 für a. Die längere Größe ist immer s (Hypotenuse)."
      ],
      "beispiel": {
        "aufgabe": "Pyramide mit s = 13 cm, a = 10 cm. Berechne die Höhe h.",
        "schritte": [
          "a : 2 = 5",
          "h² = s² − (a:2)² = 13² − 5² = 169 − 25 = 144",
          "h = √144 = 12 cm"
        ],
        "ergebnis": "h = 12 cm."
      },
      "merke": "h = √( s² − (a:2)² ). s ist stets die längste Seite.",
      "visual": {
        "type": "animation",
        "name": "pythpyr",
        "stufe": "C"
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "Rechtwinkliges Dreieck IN der Pyramide: h, (a:2) und s",
      "s² = h² + (a:2)²      →   s = √( h² + (a:2)² )",
      "h  = √( s² − (a:2)² )",
      "Pythagoras: Hypotenuse² = Kathete² + Kathete²"
    ],
    "saetze": [
      "s ist immer die Hypotenuse (die längste Seite).",
      "Achtung: immer die HALBE Grundkante nehmen (a : 2)."
    ]
  },
