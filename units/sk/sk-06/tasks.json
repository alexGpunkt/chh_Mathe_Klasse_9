  },
  "lernkarten": {
    "A": {
      "titel": "Der Kegel: Radius, Höhe, Mantellinie",
      "hinfuehrung": "Ein Kegel hat einen Kreis als Grundfläche und läuft zu einer Spitze zusammen. Drei Größen musst du benennen können.",
      "erklaerung": [
        "Radius r: vom Kreismittelpunkt zum Rand. Höhe h: senkrecht von der Spitze zur Kreismitte.",
        "Mantellinie s: die schräge Strecke von der Spitze zum Kreisrand. r, h und s bilden ein rechtwinkliges Dreieck."
      ],
      "visual": {
        "type": "koerper",
        "form": "kegel",
        "labels": {
          "r": "r",
          "h": "h",
          "s": "s"
        },
        "alt": "Kegel mit Radius r, Höhe h und Mantellinie s."
      },
      "beispiel": {
        "aufgabe": "Welche drei Größen bilden beim Kegel das rechtwinklige Dreieck?",
        "schritte": [
          "eine Kathete: Radius r",
          "andere Kathete: Höhe h",
          "Hypotenuse: Mantellinie s"
        ],
        "ergebnis": "r, h und s, mit dem rechten Winkel zwischen r und h."
      },
      "merke": "Kegel: r und h als Katheten, s als Hypotenuse."
    },
    "B": {
      "titel": "Mantellinie s mit Pythagoras",
      "hinfuehrung": "Wie bei der Pyramide steckt im Kegel ein rechtwinkliges Dreieck. Aus r und h berechnest du die Mantellinie s.",
      "erklaerung": [
        "Es gilt s² = r² + h².",
        "Also s = √( r² + h² ). Erst quadrieren und addieren, dann die Wurzel."
      ],
      "visual": {
        "type": "koerper",
        "form": "kegel",
        "labels": {
          "r": "r",
          "h": "h",
          "s": "s"
        },
        "alt": "Kegel mit dem rechtwinkligen Dreieck aus r, h und s."
      },
      "beispiel": {
        "aufgabe": "Kegel mit r = 3 cm, h = 4 cm. Berechne die Mantellinie s.",
        "schritte": [
          "s² = r² + h² = 3² + 4² = 9 + 16 = 25",
          "s = √25",
          "s = 5 cm"
        ],
        "ergebnis": "s = 5 cm."
      },
      "merke": "Kegel: s = √( r² + h² )."
    },
    "C": {
      "titel": "Rückwärts: r oder h bestimmen",
      "hinfuehrung": "Die Beziehung s² = r² + h² lässt sich nach jeder Größe umstellen – so findest du auch r oder h.",
      "erklaerung": [
        "Nach der Höhe: h = √( s² − r² ). Nach dem Radius: r = √( s² − h² ).",
        "s ist immer die längste Größe (Hypotenuse); unter der Wurzel steht das Große minus das Kleine."
      ],
      "beispiel": {
        "aufgabe": "Kegel mit s = 13 cm, r = 5 cm. Berechne die Höhe h.",
        "schritte": [
          "h² = s² − r² = 13² − 5² = 169 − 25 = 144",
          "h = √144",
          "h = 12 cm"
        ],
        "ergebnis": "h = 12 cm."
      },
      "merke": "h = √( s² − r² ),   r = √( s² − h² )."
    }
  },
  "formelkarte": {
    "formeln": [
      "Kegel: Grundkreis (Radius r), Spitze, Höhe h senkrecht zur Mitte",
