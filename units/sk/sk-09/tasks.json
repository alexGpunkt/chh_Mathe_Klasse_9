  "lernkarten": {
    "A": {
      "titel": "Volumen oder Oberfläche des Kegels?",
      "hinfuehrung": "Lies zuerst, was gesucht ist.",
      "erklaerung": [
        "„passt hinein“ oder „Liter“ → Volumen: V = (π · r² · h) : 3.",
        "„Material“ oder „anstreichen“ → Oberfläche: O = π · r · (r + s)."
      ],
      "beispiel": {
        "aufgabe": "„Wie viel Eis passt in die Waffel?“ Welche Formel?",
        "schritte": [
          "Signal „passt hinein“ → Rauminhalt",
          "→ Volumen"
        ],
        "ergebnis": "Volumen: V = (π · r² · h) : 3."
      },
      "merke": "Erst entscheiden. Dann rechnen.",
      "visual": {
        "type": "animation",
        "name": "rueckwaerts",
        "stufe": "A",
        "form": "kegel"
      }
    },
    "B": {
      "titel": "Fehlende Höhe aus dem Volumen",
      "hinfuehrung": "Ist das Volumen gegeben und die Höhe gesucht, stellst du die Volumenformel nach h um.",
      "erklaerung": [
        "Aus V = (π · r² · h) : 3 folgt h = 3 · V : (π · r²).",
        "Erst π · r² ausrechnen, dann 3 · V dadurch teilen."
      ],
      "beispiel": {
        "aufgabe": "Kegel mit V = 94,2 cm³, r = 3 cm. Höhe h (π ≈ 3,14)?",
        "schritte": [
          "π · r² = 3,14 · 9 = 28,26",
          "h = 3 · V : (π·r²) = 3 · 94,2 : 28,26",
          "h = 282,6 : 28,26 = 10 cm"
        ],
        "ergebnis": "h = 10 cm."
      },
      "merke": "h = 3 · V : (π · r²).",
      "visual": {
        "type": "animation",
        "name": "rueckwaerts",
        "stufe": "B",
        "form": "kegel"
      }
    },
    "C": {
      "titel": "Mehrschrittige Kegelaufgaben",
      "hinfuehrung": "Anspruchsvolle Aufgaben verlangen mehrere verkettete Schritte – etwa erst s, dann Oberfläche, oder erst r, dann Volumen.",
      "erklaerung": [
        "Plane die Reihenfolge und notiere Zwischenergebnisse mit Einheit.",
        "Prüfe am Ende die Plausibilität (Größenordnung im Sachzusammenhang)."
      ],
      "beispiel": {
        "aufgabe": "Kegel mit d = 6 cm, s = 5 cm. Berechne Höhe und Volumen (π ≈ 3,14).",
        "schritte": [
          "r = d : 2 = 3 cm",
          "h = √(s² − r²) = √(25 − 9) = √16 = 4 cm",
          "V = (3,14 · 9 · 4) : 3 = 113,04 : 3 ≈ 37,7 cm³"
        ],
        "ergebnis": "h = 4 cm, V ≈ 37,7 cm³."
      },
      "merke": "Reihenfolge planen, Zwischenergebnisse festhalten, Plausibilität prüfen.",
      "visual": {
        "type": "animation",
        "name": "rueckwaerts",
        "stufe": "C",
        "form": "kegel"
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "V = (π · r² · h) : 3   →   h = 3·V : (π · r²)",
      "O = π · r² + π · r · s",
      "s = √( r² + h² )",
      "Volumen braucht h · Mantel braucht s"
    ],
    "saetze": [
      "Erst fragen: Volumen (cm³) oder Oberfläche (cm²)?",
      "Volumen → Höhe h. Mantel → Mantellinie s."
    ]
  },
