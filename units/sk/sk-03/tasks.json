    "das Prisma"
  ],
  "can_do": {
    "A": "Du berechnest das Pyramidenvolumen über V = ⅓ · G · h.",
    "B": "Du berechnest die quadratische Grundfläche und daraus das Volumen.",
    "C": "Du berechnest Pyramidenvolumen in Sachaufgaben und vergleichst mit dem Prisma."
  },
  "lernkarten": {
    "A": {
      "titel": "Volumen der Pyramide",
      "hinfuehrung": "Die Pyramide fasst ein Drittel vom Prisma.",
      "erklaerung": [
        "Rechne die Grundfläche mal die Höhe.",
        "Teile das Ergebnis durch 3."
      ],
      "visual": {
        "type": "animation",
        "name": "volpyr",
        "stufe": "A"
      },
      "beispiel": {
        "aufgabe": "Eine Pyramide hat G = 30 cm² und h = 6 cm. Wie groß ist das Volumen?",
        "schritte": [
          "V = (G · h) : 3",
          "V = (30 · 6) : 3 = 180 : 3",
          "V = 60 cm³"
        ],
        "ergebnis": "V = 60 cm³."
      },
      "merke": "Pyramide: V = (G · h) : 3."
    },
    "B": {
      "titel": "Quadratische Grundfläche, dann Volumen",
      "hinfuehrung": "Bei einer quadratischen Pyramide berechnest du zuerst die Grundfläche a² und setzt sie in die Volumenformel ein.",
      "erklaerung": [
        "Grundfläche: G = a · a = a².",
        "Volumen: V = (a² · h) : 3."
      ],
      "beispiel": {
        "aufgabe": "Quadratische Pyramide: a = 6 cm, h = 10 cm. Volumen?",
        "schritte": [
          "G = a² = 6² = 36 cm²",
          "V = (36 · 10) : 3 = 360 : 3",
          "V = 120 cm³"
        ],
        "ergebnis": "V = 120 cm³."
      },
      "merke": "Quadratische Pyramide: V = (a² · h) : 3.",
      "visual": {
        "type": "animation",
        "name": "volpyr",
        "stufe": "B"
      }
    },
    "C": {
      "titel": "Sachaufgaben und Vergleich mit dem Prisma",
      "hinfuehrung": "Der Faktor ⅓ hat eine anschauliche Bedeutung: Drei gleiche Pyramiden füllen genau ein Prisma.",
      "erklaerung": [
        "Bei Sachaufgaben (Zelt, Dach, Spitze) zuerst Grundfläche und Höhe klären, dann V = (G · h) : 3.",
        "Vergleich: Prisma V = G · h, Pyramide V = (G · h) : 3 – die Pyramide fasst genau ein Drittel."
      ],
      "beispiel": {
        "aufgabe": "Ein Prisma und eine Pyramide haben G = 24 cm², h = 9 cm. Wie viel fasst jede?",
        "schritte": [
          "Prisma: V = 24 · 9 = 216 cm³",
          "Pyramide: V = 216 : 3 = 72 cm³",
          "Verhältnis 3 : 1"
        ],
        "ergebnis": "Prisma 216 cm³, Pyramide 72 cm³ – ein Drittel."
      },
      "merke": "Drei Pyramiden füllen ein Prisma gleicher Grundfläche und Höhe.",
      "visual": {
        "type": "animation",
        "name": "volpyr",
        "stufe": "C"
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "Pyramide:  V = ⅓ · Grundfläche · Höhe = (G · h) : 3",
      "quadratische Grundfläche:  G = a · a = a²",
      "Merke: Eine Pyramide passt DREIMAL in ein Prisma gleicher Grundfläche & Höhe.",
