  "lernkarten": {
    "A": {
      "titel": "Volumen des Kegels",
      "hinfuehrung": "Wie die Pyramide fasst der Kegel nur ein Drittel des passenden Zylinders. Grundkreis mal Höhe, geteilt durch 3.",
      "erklaerung": [
        "Grundkreis: A = π · r². Volumen: V = ⅓ · π · r² · h = (π · r² · h) : 3.",
        "Der Faktor ⅓ ist wie bei der Pyramide."
      ],
      "visual": {
        "type": "animation",
        "name": "volkegel",
        "stufe": "A"
      },
      "beispiel": {
        "aufgabe": "Kegel mit r = 3 cm, h = 10 cm. Volumen (π ≈ 3,14)?",
        "schritte": [
          "π · r² = 3,14 · 9 = 28,26",
          "· h = 28,26 · 10 = 282,6",
          "V = 282,6 : 3 = 94,2 cm³"
        ],
        "ergebnis": "V ≈ 94,2 cm³."
      },
      "merke": "Kegel: V = (π · r² · h) : 3."
    },
    "B": {
      "titel": "Wenn nur der Durchmesser gegeben ist",
      "hinfuehrung": "Steht statt r der Durchmesser d da, halbierst du zuerst: r = d : 2. Dann rechnest du wie gewohnt.",
      "erklaerung": [
        "r = d : 2.",
        "Dann V = (π · r² · h) : 3. Nicht den Durchmesser quadrieren!"
      ],
      "beispiel": {
        "aufgabe": "Kegel mit d = 6 cm, h = 7 cm. Volumen (π ≈ 3,14)?",
        "schritte": [
          "r = d : 2 = 3 cm",
          "π · r² · h = 3,14 · 9 · 7 = 197,82",
          "V = 197,82 : 3 ≈ 65,9 cm³"
        ],
        "ergebnis": "V ≈ 65,9 cm³."
      },
      "merke": "Erst r = d : 2, dann V = (π · r² · h) : 3.",
      "visual": {
        "type": "animation",
        "name": "volkegel",
        "stufe": "B"
      }
    },
    "C": {
      "titel": "In Litern und Vergleich mit dem Zylinder",
      "hinfuehrung": "Der Faktor ⅓ heißt anschaulich: Drei Kegel füllen genau einen Zylinder gleicher Grundfläche und Höhe.",
      "erklaerung": [
        "Für Liter in dm rechnen: dm³ = l.",
        "Vergleich: Zylinder V = π·r²·h, Kegel V = (π·r²·h) : 3 – der Kegel fasst ein Drittel."
      ],
      "beispiel": {
        "aufgabe": "Kegel mit r = 2 dm, h = 3 dm. Volumen in Litern (π ≈ 3,14)?",
        "schritte": [
          "π · r² · h = 3,14 · 4 · 3 = 37,68 dm³",
          "V = 37,68 : 3 = 12,56 dm³",
          "1 dm³ = 1 l"
        ],
        "ergebnis": "V ≈ 12,56 l (ein Drittel des Zylinders)."
      },
      "merke": "Drei Kegel füllen einen Zylinder gleicher Grundfläche und Höhe.",
      "visual": {
        "type": "animation",
        "name": "volkegel",
        "stufe": "C"
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "Kegel:  V = ⅓ · π · r² · h = (π · r² · h) : 3",
