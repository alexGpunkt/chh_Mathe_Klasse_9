{
  "unit": "KP-12",
  "title": "Prüfungstraining: Prismen & Zylinder",
  "leitidee": "L2",
  "standards": [
    "K2",
    "K3",
    "K5"
  ],
  "wortspeicher": [
    "das Volumen",
    "die Oberfläche",
    "der Zylinder",
    "das Prisma",
    "die Grundfläche",
    "die Einheit"
  ],
  "can_do": {
    "A": "Du erkennst selbst, ob Volumen oder Oberfläche gefragt ist, und rechnest sicher.",
    "B": "Du löst gemischte Prüfungsaufgaben zu Prismen und Zylindern.",
    "C": "Du begründest deinen Rechenweg und prüfst Ergebnisse auf Plausibilität."
  },
  "lernkarten": {
    "A": {
      "titel": "Volumen oder Oberfläche?",
      "hinfuehrung": "In der Prüfung steht nicht dabei, was gesucht ist. Der erste Schritt: Geht es um den Rauminhalt (Volumen) oder um die Außenhaut (Oberfläche)?",
      "erklaerung": [
        "Signalwörter für Volumen: „passt hinein“, „fasst“, „Liter“, „Rauminhalt“.",
        "Signalwörter für Oberfläche: „anstreichen“, „Material“, „einwickeln“, „Fläche“."
      ],
      "beispiel": {
        "aufgabe": "„Wie viel Liter fasst der Tank?“ Volumen oder Oberfläche?",
        "schritte": [
          "Signal „fasst“ / „Liter“",
          "→ es geht um den Rauminhalt"
        ],
        "ergebnis": "Gesucht ist das Volumen."
      },
      "merke": "„fasst/Liter“ → Volumen. „anstreichen/Material“ → Oberfläche."
    },
    "B": {
      "titel": "Gemischte Aufgaben zu Prismen und Zylindern",
      "hinfuehrung": "Jetzt kommen Prismen und Zylinder durcheinander. Du erkennst den Körper, wählst die Formel und rechnest sicher.",
      "erklaerung": [
        "Bestimme zuerst den Körper (Grundfläche!) und ob Volumen oder Oberfläche gefragt ist.",
        "Formeln von der Formelkarte: Prisma V = G·h, O = 2G + U·h; Zylinder V = π·r²·h, O = 2πr² + 2πrh."
      ],
      "beispiel": {
        "aufgabe": "Zylinder r = 2 cm, h = 5 cm. Volumen (π ≈ 3,14)?",
        "schritte": [
          "Körper: Zylinder, gesucht: Volumen",
          "V = π · r² · h = 3,14 · 4 · 5",
          "V = 62,8 cm³"
        ],
        "ergebnis": "V = 62,8 cm³."
      },
      "merke": "Erst Körper und Größe erkennen, dann passende Formel."
    },
    "C": {
      "titel": "Rechenweg begründen und prüfen",
      "hinfuehrung": "Auf höchstem Niveau schreibst du den Weg begründet auf und prüfst, ob das Ergebnis überhaupt plausibel ist.",
      "erklaerung": [
        "Begründe jeden Schritt kurz (welche Formel, warum) und gib Einheiten an.",
        "Plausibilitätsprüfung: Passt die Größenordnung? Ein Getränkekasten fasst Liter, kein Kubikmeter."
      ],
      "beispiel": {
        "aufgabe": "Fasst ein Zylinder mit r = 10 cm, h = 20 cm mehr oder weniger als 5 Liter? (π ≈ 3,14)",
        "schritte": [
          "V = 3,14 · 10² · 20 = 6280 cm³",
          "6280 cm³ = 6,28 dm³ = 6,28 l",
          "6,28 l > 5 l"
        ],
        "ergebnis": "Er fasst mehr als 5 Liter (≈ 6,3 l) – plausibel für einen Eimer."
      },
      "merke": "Begründen, Einheiten mitführen, Größenordnung prüfen."
    }
  },
  "formelkarte": {
    "formeln": [
      "Quader: V = a·b·c   O = 2(ab+ac+bc)",
      "Prisma: V = G·h    O = 2·G + Umfang·h",
      "Zylinder: V = π·r²·h    O = 2πr² + 2πrh",
      "1 l = 1 dm³ = 1000 cm³    Masse = V · Dichte"
    ],
    "saetze": [
      "Zuerst fragen: Volumen (cm³) oder Oberfläche (cm²)?",
      "Zum Schluss prüfen: passt die Größenordnung?"
    ]
  },
