  "can_do": {
    "A": "Du zerlegst einen zusammengesetzten Körper in Grundformen und addierst die Volumen.",
    "B": "Du berechnest Füllmengen und Massen über Volumen · Dichte.",
    "C": "Du löst mehrschrittige Sachaufgaben mit Hohlkörpern und Einheitenwechsel."
  },
  "lernkarten": {
    "A": {
      "titel": "Zusammengesetzte Körper zerlegen",
      "hinfuehrung": "Viele Körper bestehen aus einfachen Teilen.",
      "erklaerung": [
        "Suche die einfachen Teile: Quader, Würfel, Zylinder.",
        "Rechne jedes Volumen einzeln aus. Zähle alles zusammen."
      ],
      "beispiel": {
        "aufgabe": "Ein Quader 4 · 4 · 2 hat einen Würfel mit a = 2 darauf. Wie groß ist das Volumen?",
        "schritte": [
          "Quader = 4 · 4 · 2 = 32 cm³",
          "Würfel = 2³ = 8 cm³",
          "V = 32 + 8 = 40 cm³"
        ],
        "ergebnis": "V = 40 cm³."
      },
      "merke": "Zerlegen. Einzeln rechnen. Addieren.",
      "visual": {
        "type": "animation",
        "name": "zusammengesetzt",
        "stufe": "A"
      }
    },
    "B": {
      "titel": "Masse über Volumen mal Dichte",
      "hinfuehrung": "Aus dem Volumen und dem Material (Dichte) lässt sich die Masse berechnen – so schwer ist der Körper.",
      "erklaerung": [
        "Masse = Volumen · Dichte. Die Dichte steht oft in g/cm³ (z. B. Eisen ≈ 7,8 g/cm³).",
        "Achte darauf, dass Volumen und Dichte zusammenpassen (cm³ zu g/cm³)."
      ],
      "beispiel": {
        "aufgabe": "Ein Eisenquader hat V = 50 cm³, Dichte 7,8 g/cm³. Masse?",
        "schritte": [
          "Masse = V · Dichte",
          "= 50 · 7,8",
          "= 390 g"
        ],
        "ergebnis": "Die Masse beträgt 390 g."
      },
      "merke": "Masse = Volumen · Dichte (cm³ · g/cm³ = g).",
      "visual": {
        "type": "animation",
        "name": "zusammengesetzt",
        "stufe": "B"
      }
    },
    "C": {
      "titel": "Hohlkörper und Einheitenwechsel",
      "hinfuehrung": "Bei Rohren und Bechern zählt nur das Material zwischen außen und innen. Du rechnest Außenvolumen minus Innenvolumen.",
      "erklaerung": [
        "Hohlkörper: V = V_außen − V_innen.",
        "Bei mehrschrittigen Sachaufgaben zwischendurch die Einheiten sauber wechseln (z. B. cm³ → l) und Zwischenergebnisse notieren."
      ],
      "beispiel": {
        "aufgabe": "Ein Rohr: außen r = 5 cm, innen r = 4 cm, Länge 10 cm. Materialvolumen (π ≈ 3,14)?",
        "schritte": [
          "außen = 3,14 · 5² · 10 = 785 cm³",
          "innen = 3,14 · 4² · 10 = 502,4 cm³",
          "V = 785 − 502,4 = 282,6 cm³"
        ],
        "ergebnis": "Materialvolumen ≈ 282,6 cm³."
      },
      "merke": "Hohlkörper: außen minus innen.",
      "visual": {
        "type": "animation",
        "name": "zusammengesetzt",
        "stufe": "C"
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "Zusammengesetzt: in Teilkörper zerlegen, Volumen addieren",
      "Hohlkörper: V = V_außen − V_innen",
