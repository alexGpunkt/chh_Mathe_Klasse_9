{
  "unit": "KP-07",
  "title": "Volumen des Prismas berechnen",
  "leitidee": "L2",
  "standards": [
    "K5",
    "K3"
  ],
  "wortspeicher": [
    "das Volumen",
    "die Grundfläche",
    "die Höhe",
    "das Dreieck",
    "das Trapez",
    "zerlegen"
  ],
  "worterklaerungen": {
    "Volumen": "Wie viel in einen Körper hineinpasst. Man gibt es in cm³ an.",
    "Grundfläche": "Die Fläche unten am Körper. Sie gibt dem Körper den Namen.",
    "Höhe": "Wie hoch ein Körper ist. Sie steht immer senkrecht.",
    "Dreieck": "Eine Fläche mit drei Ecken.",
    "Trapez": "Eine Fläche mit vier Ecken. Zwei Seiten liegen parallel.",
    "zerlegen": "In einfache Teile aufteilen."
  },
  "can_do": {
    "A": "Du berechnest das Volumen eines Prismas mit dreieckiger Grundfläche.",
    "B": "Du berechnest Volumen bei dreieckiger und trapezförmiger Grundfläche sicher.",
    "C": "Du berechnest Volumen zusammengesetzter Prismen und in Sachaufgaben."
  },
  "lernkarten": {
    "A": {
      "titel": "Volumen des Dreiecksprismas",
      "hinfuehrung": "Hier ist die Grundfläche ein Dreieck.",
      "erklaerung": [
        "Rechne zuerst die Dreiecksfläche: G = (g · h_d) : 2.",
        "Nimm G dann mal die Länge h."
      ],
      "visual": {
        "type": "animation",
        "name": "prisma",
        "stufe": "A"
      },
      "beispiel": {
        "aufgabe": "g = 8 cm, h_d = 3 cm, Länge h = 12 cm. Wie groß ist das Volumen?",
        "schritte": [
          "G = (8 · 3) : 2 = 12 cm²",
          "V = G · h = 12 · 12",
          "V = 144 cm³"
        ],
        "luecke": {
          "schritt": 2,
          "wert": 144,
          "einheit": "cm³"
        },
        "ergebnis": "V = 144 cm³."
      },
      "merke": "Erst G = (g · h_d) : 2. Dann V = G · h."
    },
    "B": {
      "titel": "Auch mit trapezförmiger Grundfläche",
      "hinfuehrung": "Ob Dreieck oder Trapez – der zweite Schritt bleibt gleich. Nur die Grundfläche wird anders berechnet.",
      "erklaerung": [
        "Trapez: G = (a + c) : 2 · h_d, mit den parallelen Seiten a und c.",
        "Anschließend V = G · h."
      ],
      "beispiel": {
        "aufgabe": "Trapez-Prisma: a = 6 cm, c = 4 cm, h_d = 3 cm, Länge h = 10 cm. Volumen?",
        "schritte": [
          "G = (6 + 4) : 2 · 3 = 5 · 3 = 15 cm²",
          "V = 15 · 10",
          "V = 150 cm³"
        ],
        "ergebnis": "V = 150 cm³."
      },
      "merke": "Trapez: G = (a + c) : 2 · h_d, dann V = G · h.",
      "visual": {
        "type": "animation",
        "name": "prisma",
        "stufe": "B"
      }
    },
    "C": {
      "titel": "Zusammengesetzte Prismen und Sachaufgaben",
      "hinfuehrung": "Reale Körper wie ein Dachfirst oder eine Rinne bestehen aus mehreren Prismen. Du rechnest die Teile und addierst.",
      "erklaerung": [
        "Zerlege den Körper in einfache Prismen, berechne jedes Volumen und addiere.",
        "Bei Sachaufgaben zuerst die Einheiten prüfen und am Ende in eine sinnvolle Einheit (oft Liter) umrechnen."
      ],
      "beispiel": {
        "aufgabe": "Ein Haus-Querschnitt: Rechteck (6 · 3) plus Dachdreieck (g = 6, h_d = 2), Länge 10 m. Volumen?",
        "schritte": [
          "Rechteckprisma: (6 · 3) · 10 = 180 m³",
          "Dachprisma: ((6·2):2) · 10 = 6 · 10 = 60 m³",
          "V = 180 + 60 = 240 m³"
        ],
        "ergebnis": "V = 240 m³."
      },
      "merke": "In Teilprismen zerlegen, Volumen addieren.",
      "visual": {
        "type": "animation",
        "name": "prisma",
        "stufe": "C"
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "V = Grundfläche · Höhe",
      "Dreieck:  G = (g · h_d) : 2",
      "Trapez:   G = (a + c) : 2 · h_d",
      "L-Form: in Rechtecke zerlegen und addieren"
    ],
    "saetze": [
      "Erst die Grundfläche, dann mal die Prismenhöhe.",
      "Beim Dreieck nie das ':2' vergessen."
    ]
  },
