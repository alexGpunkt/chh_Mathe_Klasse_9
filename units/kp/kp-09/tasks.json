  ],
  "worterklaerungen": {
    "Zylinder": "Ein Körper wie eine Dose. Unten und oben ist ein Kreis.",
    "Radius": "Die Strecke von der Kreismitte bis zum Rand.",
    "Durchmesser": "Die Strecke quer durch den Kreis, genau durch die Mitte. Sie ist doppelt so lang wie der Radius.",
    "Kreisfläche": "Wie groß ein Kreis ist. Du rechnest π · r · r.",
    "Kreiszahl π": "Eine feste Zahl für Kreise. Du rechnest meist mit 3,14.",
    "Höhe": "Wie hoch ein Körper ist. Sie steht immer senkrecht."
  },
  "can_do": {
    "A": "Du berechnest die Kreisfläche mit π · r² und daraus V = π · r² · h.",
    "B": "Du berechnest Zylindervolumen, auch wenn nur der Durchmesser gegeben ist.",
    "C": "Du berechnest Zylindervolumen in Litern und in Sachaufgaben."
  },
  "lernkarten": {
    "A": {
      "titel": "Volumen des Zylinders",
      "hinfuehrung": "Der Zylinder hat einen Kreis als Grundfläche.",
      "erklaerung": [
        "Rechne zuerst die Kreisfläche: A = π · r².",
        "Nimm die Kreisfläche dann mal die Höhe."
      ],
      "visual": {
        "type": "animation",
        "name": "zylinder",
        "stufe": "A"
      },
      "beispiel": {
        "aufgabe": "Ein Zylinder hat r = 5 cm und h = 10 cm. Volumen mit π ≈ 3,14?",
        "schritte": [
          "A = π · r² = 3,14 · 25 = 78,5 cm²",
          "V = A · h = 78,5 · 10",
          "V = 785 cm³"
        ],
        "luecke": {
          "schritt": 2,
          "wert": 785,
          "einheit": "cm³"
        },
        "ergebnis": "V ≈ 785 cm³."
      },
      "merke": "Zylinder: V = π · r² · h."
    },
    "B": {
      "titel": "Wenn nur der Durchmesser gegeben ist",
      "hinfuehrung": "In der Formel steht der Radius. Ist nur der Durchmesser d angegeben, halbierst du ihn zuerst.",
      "erklaerung": [
        "d = 2 · r, also r = d : 2.",
        "Erst r bestimmen, dann V = π · r² · h. Häufiger Fehler: den Durchmesser statt des Radius quadrieren."
      ],
      "visual": {
        "type": "animation",
        "name": "zylinder",
        "stufe": "B"
      },
      "beispiel": {
        "aufgabe": "Dose mit d = 8 cm, h = 12 cm. Volumen (π ≈ 3,14)?",
        "schritte": [
          "r = d : 2 = 8 : 2 = 4 cm",
          "A = 3,14 · 4² = 3,14 · 16 = 50,24 cm²",
          "V = 50,24 · 12 ≈ 602,9 cm³"
        ],
        "ergebnis": "V ≈ 602,9 cm³."
      },
      "merke": "Erst r = d : 2, dann rechnen – nie den Durchmesser quadrieren."
    },
    "C": {
      "titel": "Zylindervolumen in Litern und Sachaufgaben",
      "hinfuehrung": "Bei Tanks und Behältern ist die Antwort oft in Litern gefragt. Rechne in dm, dann ist das Ergebnis direkt in Litern.",
      "erklaerung": [
        "Wandle Radius und Höhe in dm um. Das Volumen in dm³ ist gleich der Literzahl.",
        "Runde sinnvoll und prüfe die Größenordnung am Sachzusammenhang."
      ],
      "beispiel": {
        "aufgabe": "Regentonne: r = 3 dm, h = 8 dm. Wie viele Liter (π ≈ 3,14)?",
        "schritte": [
          "A = 3,14 · 3² = 3,14 · 9 = 28,26 dm²",
          "V = 28,26 · 8 = 226,08 dm³",
          "1 dm³ = 1 l"
        ],
        "ergebnis": "V ≈ 226 l."
      },
      "merke": "In dm rechnen → dm³ = Liter.",
      "visual": {
        "type": "animation",
        "name": "zylinder",
        "stufe": "C"
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "Kreisfläche:  A = π · r²",
      "Zylinder:  V = π · r² · h   ( = Grundfläche · Höhe )",
      "Durchmesser d = 2 · r   →   r = d : 2",
      "π ≈ 3,14   (oder die π-Taste)"
    ],
    "saetze": [
      "Erst die Kreisfläche, dann mal die Höhe.",
      "Immer prüfen: ist r oder d gegeben?"
    ]
  },
